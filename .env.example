# Spark Curiosity – AI-Provider und Modell
# Kopiere diese Datei nach .env und trage deine Werte ein:
#   cp .env.example .env

# GitHub (für Private-Repo-Installer install.ps1 unter Windows)
# GITHUB_TOKEN=dein_github_personal_access_token

# Provider: ollama (lokal) oder grok (xAI API)
SPARK_AI_PROVIDER=ollama

# --- Ollama (wenn SPARK_AI_PROVIDER=ollama) ---
SPARK_LOCAL_LLM_MODEL=phi3:mini
# SPARK_OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Cloudflare-Proxy (xAI + OpenAI-kompatibel, z. B. Whisper STT) ---
# Ohne direkte Provider-Keys auf dem Client: Companion nutzt Worker-Token + SPARK_CLOUD_PROXY_URL.
# Beispiel (Production): https://spark-proxy.spark-curiosity.workers.dev
# SPARK_CLOUD_PROXY_URL=https://spark-proxy.spark-curiosity.workers.dev
# Optional: Secret nur fuer POST /register (Token-Ausstellung)
# SPARK_CLOUD_REGISTER_SECRET=...

# --- Next Check / Heartbeat (nur Host-Fallbacks; Modell nutzt Tool set_next_check) ---
# Desktop: wenn Companion kein nextCheckSeconds liefert (z.B. Modell hat set_next_check vergessen nach Redirect)
# — empfohlen im Band 60–300 fuer kritische Kontexte; Standard 90:
# SPARK_DESKTOP_HEARTBEAT_SECONDS=90
# Companion: leere toolCalls ohne Redirect/Quote/Prompt — Idle fuer produktive Seiten, Band 900–1500; Standard 1200:
# SPARK_IDLE_NEXT_CHECK_SECONDS=1200
# Host-Policy (Curated-Gate / Extension, ohne LLM): Band 60–300; Standard 120:
# SPARK_POLICY_NEXT_CHECK_SECONDS=120

