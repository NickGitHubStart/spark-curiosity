# Spark Curiosity – AI-Provider und Modell
# Kopiere diese Datei nach .env und trage deine Werte ein:
#   cp .env.example .env

# GitHub (für Private-Repo-Installer install.ps1 unter Windows)
# GITHUB_TOKEN=dein_github_personal_access_token

# Provider: ollama (lokal) oder grok (xAI API)
SPARK_AI_PROVIDER=ollama

# --- Ollama (wenn SPARK_AI_PROVIDER=ollama) ---
SPARK_LOCAL_LLM_MODEL=phi3:mini
# SPARK_OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Grok / xAI (wenn SPARK_AI_PROVIDER=grok) ---
# API-Key von https://console.x.ai/
# SPARK_GROK_API_KEY=dein_xai_api_key
# Modell: grok-4-1-fast-reasoning (empfohlen), grok-4-1-fast, grok-2-latest
# SPARK_GROK_MODEL=grok-4-1-fast-reasoning
