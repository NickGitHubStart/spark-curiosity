{
  "name": "spark-curiosity",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo scaffold for Spark Curiosity MVP",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "build:extension": "npm run build -w @spark/extension",
    "build:desktop": "npm run build -w @spark/desktop-agent",
    "sync:extension:windows": "bash scripts/sync-extension-to-windows.sh",
    "build:win-ext": "npm run build:extension && npm run sync:extension:windows",
    "start:local": "bash scripts/start-local.sh",
    "start:desktop": "npm run dev -w @spark/desktop-agent",
    "start:desktop:local": "bash scripts/start-desktop.sh",
    "test:companion": "npm run test -w @spark/companion",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "npm run lint -ws --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
