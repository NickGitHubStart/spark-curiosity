{
  "name": "spark-curiosity",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Monorepo scaffold for Spark Curiosity MVP",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "build:desktop": "npm run build -w @spark/desktop-agent",
    "build:runtime": "npm run build -w @spark/desktop-runtime",
    "build:desktop-stack": "npm run build -w @spark/shared && npm run build -w @spark/companion && npm run build:desktop && npm run build:runtime",
    "start:local": "bash scripts/start-local.sh",
    "start:desktop": "npm run dev -w @spark/desktop-agent",
    "start:desktop:local": "bash scripts/start-desktop.sh",
    "start:runtime": "npm run dev -w @spark/desktop-runtime",
    "start:runtime:local": "bash scripts/start-runtime.sh",
    "install:win": "powershell -ExecutionPolicy Bypass -File scripts/windows/install.ps1",
    "runtime:install:win": "powershell -ExecutionPolicy Bypass -File scripts/windows/install-runtime.ps1",
    "runtime:bootstrap:win": "powershell -ExecutionPolicy Bypass -File scripts/windows/bootstrap-install.ps1",
    "runtime:bootstrap:update:win": "powershell -ExecutionPolicy Bypass -File scripts/windows/bootstrap-update.ps1",
    "runtime:bootstrap:uninstall:win": "powershell -ExecutionPolicy Bypass -File scripts/windows/bootstrap-uninstall.ps1",
    "runtime:quick-install:win": "powershell -ExecutionPolicy Bypass -File scripts/windows/quick-install.ps1",
    "runtime:start:win": "powershell -ExecutionPolicy Bypass -File scripts/windows/start-runtime.ps1",
    "runtime:stop:win": "powershell -ExecutionPolicy Bypass -File scripts/windows/stop-runtime.ps1",
    "runtime:status:win": "powershell -ExecutionPolicy Bypass -File scripts/windows/status-runtime.ps1",
    "runtime:doctor:win": "powershell -ExecutionPolicy Bypass -File scripts/windows/doctor-runtime.ps1",
    "runtime:uninstall:win": "powershell -ExecutionPolicy Bypass -File scripts/windows/uninstall-runtime.ps1",
    "runtime:dev:win": "powershell -ExecutionPolicy Bypass -File scripts/windows/runtime-dev.ps1",
    "test:companion": "npm run test -w @spark/companion",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "npm run lint -ws --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
